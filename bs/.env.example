PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGO_DB_NAME=<database-name>
CORS_ORIGIN=http://localhost:5173
# Set this to the address used by other devices, for example http://192.168.1.20:5173
CORS_ORIGIN_NETWORK=
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
REFRESH_TOKEN_EXPIRY=7d
